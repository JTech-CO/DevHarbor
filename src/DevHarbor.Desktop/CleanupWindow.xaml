<Window x:Class="DevHarbor.Desktop.CleanupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DevHarbor · 정리와 복구" Width="1100" Height="820" MinWidth="900" MinHeight="740" WindowStartupLocation="CenterOwner" Background="#F4F7F9" Foreground="#22354B" FontFamily="맑은 고딕" FontSize="13">
 <Grid Margin="28" Background="#F4F7F9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="정리와 복구" FontSize="28" FontWeight="Bold"/><TextBlock Text="실행 전 대상을 확인하고, 모든 파일 이동을 기록합니다." Foreground="#607386" Margin="0,10,0,18"/></StackPanel>
 <Border Grid.Row="1" Background="#FFF1D6" CornerRadius="9" Padding="18" Margin="0,0,0,18"><StackPanel><TextBlock Text="실제 캐시 정리 · 검증 대기" FontWeight="Bold" Foreground="#805B20"/><TextBlock x:Name="AssessmentText" TextWrapping="Wrap" Margin="0,9,0,0" Foreground="#805B20"/></StackPanel></Border>
 <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="샘플 보관·복구 이력" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="앱이 만든 작은 파일로 승인 흐름을 확인합니다. 공간 확보량은 0 bytes입니다." Foreground="#607386" Margin="0,7,12,0"/></StackPanel><Button x:Name="CreateButton" Grid.Column="1" Content="샘플로 승인 흐름 확인" Click="CreateSample" Background="#207E74" Foreground="White"/></Grid>
 <DataGrid Grid.Row="3" x:Name="HistoryTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="샘플 이동 및 복구 이력">
  <DataGrid.Columns><DataGridTextColumn Header="작업" Binding="{Binding Action}" Width="85"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="원래 위치" Binding="{Binding Source}" Width="*" MinWidth="320"/><DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="155"/></DataGrid.Columns>
 </DataGrid>
 <StackPanel Grid.Row="4" Margin="0,14,0,14"><TextBlock x:Name="DetailText" TextWrapping="Wrap" MaxHeight="100" Foreground="#526B7D"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AlternateName" AutomationProperties.Name="다른 복원 파일명" ToolTip="원래 이름을 사용하려면 비워 두세요. 이름만 입력할 수 있습니다."/><Button Grid.Column="1" x:Name="RestoreButton" Content="선택 파일 복원 검토" Click="Restore" IsEnabled="False" Margin="10,0,10,0"/><Button Grid.Column="2" x:Name="RefreshButton" Content="상태 다시 확인" Click="Refresh"/></Grid><TextBlock Text="다른 복원 파일명 (선택) · 기존 파일을 덮어쓰지 않습니다." FontSize="11" Foreground="#607386" Margin="0,6,0,0"/></StackPanel>
 <Border Grid.Row="5" Background="#E4EEF1" CornerRadius="8" Padding="14"><DockPanel><Button x:Name="StopButton" DockPanel.Dock="Right" Content="중지 요청" Click="Stop" IsEnabled="False" Margin="12,0,0,0"/><TextBlock x:Name="StatusText" Text="이력을 불러오는 중입니다." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#365C6B"/></DockPanel></Border>
 </Grid>
</Window>
