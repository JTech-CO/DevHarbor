<Window x:Class="DevHarbor.Desktop.ModelSessionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DevHarbor · 모델 세션" Width="1060" Height="780" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#F4F7F9" Foreground="#22354B" FontFamily="맑은 고딕" FontSize="13">
 <Grid Background="#F4F7F9" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="모델 세션" FontSize="28" FontWeight="Bold"/><TextBlock Text="이 PC의 Ollama에 올라온 모델을 확인합니다." Foreground="#607386" Margin="0,10,0,18"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="로드 상태 조회" Click="Refresh" VerticalAlignment="Top" Background="#207E74" Foreground="White"/></Grid>
 <Border Grid.Row="1" Background="#E4EEF1" CornerRadius="8" Padding="16" Margin="0,0,0,18"><TextBlock Text="언로드는 메모리에서 모델을 내리는 요청입니다. 디스크의 모델 파일은 삭제하지 않으며, 다음 사용 시 다시 로드될 수 있습니다. 다른 앱의 모델 사용에 영향을 줄 수 있습니다." TextWrapping="Wrap" Foreground="#365C6B"/></Border>
 <TextBlock Grid.Row="2" x:Name="MemoryText" Text="API 모델 크기·VRAM·프로세스 working set을 서로 합산하지 않습니다. RAM은 미측정입니다." TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#607386"/>
 <DataGrid Grid.Row="3" x:Name="ModelsTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionChanged="SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="모델" Binding="{Binding Name}" Width="*" MinWidth="230"/><DataGridTextColumn Header="API 모델 크기" Binding="{Binding Size}" Width="150"/><DataGridTextColumn Header="API VRAM" Binding="{Binding Vram}" Width="150"/><DataGridTextColumn Header="로드 만료 시각" Binding="{Binding Expires}" Width="185"/></DataGrid.Columns></DataGrid>
 <Grid Grid.Row="4" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="이번 창의 요청 결과" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="UnloadButton" Content="선택 모델 언로드 검토" Click="Unload" IsEnabled="False"/></Grid>
 <ListBox Grid.Row="5" x:Name="HistoryList" BorderBrush="#CED9E1" Padding="10"/>
 <TextBlock Grid.Row="6" x:Name="StatusText" Text="조회 버튼을 눌러 시작하세요. 원격·사용자 지정 endpoint는 지원하지 않습니다." TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#526B7D"/>
 </Grid>
</Window>
