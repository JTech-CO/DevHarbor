<Window x:Class="DevHarbor.Desktop.UnloadApprovalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DevHarbor · 모델 언로드 확인" Width="740" Height="550" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F4F7F9" Foreground="#22354B" FontFamily="맑은 고딕" FontSize="13">
 <Grid Margin="28" Background="#F4F7F9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="선택 모델을 메모리에서 내릴까요?" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
 <StackPanel Grid.Row="1"><TextBlock x:Name="TargetText" TextWrapping="Wrap" FontWeight="SemiBold"/><Border Background="#FFF1D6" Padding="16" CornerRadius="8" Margin="0,20,0,16"><TextBlock Text="다른 앱에서 사용 중인 모델에 영향을 줄 수 있습니다. 디스크 모델 파일은 보존되며 다음 요청 시 다시 로드될 수 있습니다. 조회와 실행 사이에 상태가 바뀌거나 요청이 시간 초과되면 결과를 다시 확인해야 합니다." TextWrapping="Wrap" Foreground="#805B20"/></Border><TextBlock Text="확보될 RAM/VRAM 크기는 보장하지 않습니다." Foreground="#607386"/></StackPanel>
 <StackPanel Grid.Row="2" Margin="0,10,0,20"><TextBlock x:Name="ExpiryText" Margin="0,0,0,10" Foreground="#805B20"/><CheckBox x:Name="Acknowledged" Content="선택 모델과 사용 중인 앱에 미칠 영향을 확인했습니다." Checked="Changed" Unchecked="Changed"/></StackPanel>
 <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" IsCancel="True" Margin="0,0,12,0"/><Button x:Name="ConfirmButton" Content="이 모델 언로드 승인" IsEnabled="False" Click="Confirm" Background="#207E74" Foreground="White"/></StackPanel></Grid>
</Window>
