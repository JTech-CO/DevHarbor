<Window x:Class="DevHarbor.Desktop.ConnectionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DevHarbor · 에이전트 연결" Width="1040" Height="850" MinWidth="880" MinHeight="730" WindowStartupLocation="CenterOwner" Background="#F4F7F9" Foreground="#22354B" FontFamily="맑은 고딕" FontSize="13">
 <Grid Background="#F4F7F9" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="에이전트 연결" FontSize="28" FontWeight="Bold"/><TextBlock Text="앱에서 공유한 스캔 결과를 에이전트가 읽고 계획을 검토합니다." Foreground="#607386" Margin="0,10,0,18"/></StackPanel>
 <Border Grid.Row="1" Background="#FFF1D6" CornerRadius="8" Padding="16" Margin="0,0,0,16"><TextBlock Text="공유하면 도구 이름·로컬 경로·용량·관측 시각이 연결한 AI 클라이언트에 전달됩니다. 파일 내용과 인증 정보는 제공하지 않습니다. 이후 스캔 결과도 공유되며, 공유 중지 또는 앱 종료 시 연결이 닫힙니다." TextWrapping="Wrap" Foreground="#805B20"/></Border>
 <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SharingStatus" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Grid.Column="1" x:Name="SharingButton" Content="스캔 결과 공유 시작" Click="ToggleSharing" Background="#207E74" Foreground="White"/></Grid>
 <TextBox Grid.Row="3" x:Name="ConfigText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="MCP 연결 설정 예시"/>
 <TextBlock Grid.Row="4" Text="에이전트 계획 검토 · 실제 캐시 실행은 차단됩니다" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,12"/>
 <DataGrid Grid.Row="5" x:Name="PlanTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="계획 ID" Binding="{Binding Id}" Width="*" MinWidth="230"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="140"/><DataGridCheckBoxColumn Header="앱에서 검토함" Binding="{Binding Reviewed}" Width="120"/><DataGridTextColumn Header="만료 시각" Binding="{Binding ExpiresAt}" Width="240"/></DataGrid.Columns></DataGrid>
 <Grid Grid.Row="6" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="클라이언트 설정은 자동으로 수정하지 않습니다. 설정 예시를 직접 등록하세요." TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="선택 계획 근거 보기" Click="ReviewPlan" Margin="16,0,0,0"/></Grid>
 </Grid>
</Window>
