<Window x:Class="DevHarbor.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="DevHarbor · 저장소 지도" Width="1360" Height="920" MinWidth="1120" MinHeight="800" WindowStartupLocation="CenterScreen" Background="#F4F7F9" Foreground="#22354B" FontFamily="맑은 고딕" FontSize="13" UseLayoutRounding="True">
  <Grid x:Name="PageRoot" Background="#F4F7F9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142B39"><Grid Margin="22,32,20,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><Border Background="#2FABA0" Width="42" Height="42" CornerRadius="12" HorizontalAlignment="Left"><TextBlock Text="DH" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="DevHarbor" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,16,0,5"/><TextBlock Text="개발 공간을 한눈에" Foreground="#A9BEC9"/></StackPanel>
      <StackPanel Grid.Row="1"><Border Background="#274451" CornerRadius="7" Padding="14,13" Margin="-2,42,-2,0"><TextBlock Text="◉   저장소 지도" Foreground="#A2E6D9" FontWeight="SemiBold"/></Border><Button Content="정리·복구" Click="OpenCleanup" Margin="0,12,0,0" Background="#274451" Foreground="#DDE9EE"/><Button Content="모델 세션" Click="OpenModels" Margin="0,12,0,0" Background="#274451" Foreground="#DDE9EE"/><Button Content="에이전트 연결" Click="OpenConnections" Margin="0,12,0,0" Background="#274451" Foreground="#DDE9EE"/></StackPanel>
      <StackPanel Grid.Row="3"><TextBlock Text="읽기 전용 탐색" Foreground="#DDE9EE" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="어디에 얼마나 쌓였는지&#x0a;먼저 확인하세요." TextWrapping="Wrap" Foreground="#9EB5C1" LineHeight="23"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="30,26,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="저장소 지도" FontSize="29" FontWeight="Bold"/><TextBlock Text="개발 도구와 로컬 AI가 사용하는 공간을 확인하세요." Foreground="#64798B" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="1" Background="#DEF0E9" CornerRadius="14" Padding="14,7" VerticalAlignment="Top"><TextBlock Text="●  읽기 전용" Foreground="#287361" FontWeight="SemiBold"/></Border></Grid>
      <UniformGrid Grid.Row="1" Columns="3" Margin="0,24,0,18">
        <Border Background="White" CornerRadius="10" Padding="20,16" Margin="0,0,10,0"><StackPanel><TextBlock Text="중복 제외 · 할당 용량" Foreground="#607386"/><TextBlock Text="{Binding AllocatedSummary}" FontSize="29" FontWeight="Bold" Margin="0,8,0,6"/><TextBlock Text="측정된 로컬 파일 · 회수 가능량 아님" FontSize="11" Foreground="#718598"/></StackPanel></Border>
        <Border Background="White" CornerRadius="10" Padding="20,16" Margin="0,0,10,0"><StackPanel><TextBlock Text="중복 제외 · 논리 용량" Foreground="#607386"/><TextBlock Text="{Binding LogicalSummary}" FontSize="29" FontWeight="Bold" Margin="0,8,0,6"/><TextBlock Text="공유 파일과 중첩 경로는 한 번만 합산" FontSize="11" Foreground="#718598"/></StackPanel></Border>
        <Border Background="White" CornerRadius="10" Padding="20,16"><StackPanel><TextBlock Text="측정 범위" Foreground="#607386"/><TextBlock Text="{Binding CoverageSummary}" FontSize="25" FontWeight="Bold" Margin="0,8,0,10"/><TextBlock Text="{Binding CoverageNote}" FontSize="11" Foreground="#718598"/></StackPanel></Border>
      </UniformGrid>
      <Grid Grid.Row="2" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox Width="145" ItemsSource="{Binding Drives}" SelectedItem="{Binding DriveFilter}" AutomationProperties.Name="드라이브 필터"/>
        <ComboBox Grid.Column="1" Width="166" Margin="10,0,0,0" ItemsSource="{Binding Environments}" SelectedItem="{Binding EnvironmentFilter}" AutomationProperties.Name="환경 필터"/>
        <Button Grid.Column="3" Content="스캔 중지" Command="{Binding CancelCommand}" Margin="10,0,10,0"/>
        <Button Grid.Column="4" Content="저장소 스캔" Command="{Binding ScanCommand}" Background="#207E74" Foreground="White"/>
      </Grid>
      <Border Grid.Row="3" Background="#EAF0F4" CornerRadius="7" Padding="12,8" Margin="0,0,0,12"><TextBlock Text="{Binding StatusText}" Foreground="#526B7D" TextWrapping="Wrap"/></Border>
      <Border Grid.Row="4" Background="White" CornerRadius="8" BorderBrush="#E0E7EC" BorderThickness="1"><Grid>
        <DataGrid x:Name="StorageTable" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F4" RowBackground="White" AlternatingRowBackground="#FAFCFD" BorderThickness="0" Background="Transparent" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" EnableRowVirtualization="True" AutomationProperties.Name="도구별 저장소">
          <DataGrid.Columns>
            <DataGridTextColumn Header="도구" Binding="{Binding Tool}" Width="145"/>
            <DataGridTextColumn Header="논리 용량" Binding="{Binding Logical}" Width="125"/>
            <DataGridTextColumn Header="할당 용량" Binding="{Binding Allocated}" Width="125"/>
            <DataGridTextColumn Header="공유 포함분" Binding="{Binding Shared}" Width="125"/>
            <DataGridTextColumn Header="환경" Binding="{Binding Environment}" Width="120"/>
            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="*" MinWidth="155"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="아직 조사한 저장소가 없습니다.&#x0a;&#x0a;‘저장소 스캔’으로 설치된 도구의 경로를 확인하세요." TextAlignment="Center" VerticalAlignment="Center" Foreground="#78909F" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AllRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid></Border>
      <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="16,13" Margin="0,12,0,12"><StackPanel>
        <TextBlock Text="{Binding Selected.Title, TargetNullValue=항목을 선택하면 경로와 측정 근거를 볼 수 있습니다.}" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBlock Text="{Binding Selected.Root}" TextWrapping="Wrap" Foreground="#496679" MaxHeight="42"/>
        <TextBlock Text="{Binding Selected.Evidence}" TextWrapping="Wrap" Foreground="#64798B" Margin="0,5,0,0" MaxHeight="50"/>
        <TextBlock Text="{Binding Selected.Detail}" TextWrapping="Wrap" Foreground="#64798B" Margin="0,5,0,0" MaxHeight="50"/>
      </StackPanel></Border>
      <StackPanel Grid.Row="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CustomPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="스캔할 도구 저장소의 절대 경로" AutomationProperties.Name="사용자 저장소 경로"/><Button Grid.Column="1" Content="사용자 경로 추가" Command="{Binding AddPathCommand}" Margin="10,0,0,0"/></Grid><TextBlock Text="복구 가능성·사용 중 여부는 아직 판단하지 않습니다. 도구별 용량은 공유될 수 있으며, Docker 수치는 전체 합계에서 제외됩니다." TextWrapping="Wrap" FontSize="11" Foreground="#728797" Margin="0,12,0,0"/></StackPanel>
    </Grid>
  </Grid>
</Window>
